includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6

    paths:
        - app
        - routes
        - database/factories
        - database/seeders
        - tests

    parseModelCastsMethod: true

    excludePaths:
        - bootstrap/cache
        - storage
        - vendor
        - node_modules

    ignoreErrors:
        -
            identifier: missingType.iterableValue
        -
            identifier: missingType.generics
        -
            identifier: missingType.parameter
