{
    "uid": "ledgerpay-operational",
    "title": "LedgerPay — операционные метрики",
    "description": "Метрики ledgerpay_* из Prometheus (снимок Redis). projection_*_row_gap — не lag событий; пустой snapshot может дать нули. ADR-015.",
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "tags": ["ledgerpay", "operational"],
    "time": { "from": "now-6h", "to": "now" },
    "editable": true,
    "graphTooltip": 1,
    "panels": [
        {
            "id": 1,
            "type": "text",
            "title": "Примечание",
            "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
            "options": {
                "mode": "markdown",
                "content": "Источник: `GET /metrics` → Prometheus. Обновление business-метрик ~1 мин (`ledgerpay:metrics:refresh`)."
            }
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Сбор БД успешен",
            "gridPos": { "h": 4, "w": 8, "x": 0, "y": 3 },
            "datasource": { "type": "prometheus", "uid": "ledgerpay-prometheus" },
            "targets": [{ "expr": "ledgerpay_collector_success", "refId": "A" }],
            "fieldConfig": { "defaults": { "unit": "none" } }
        },
        {
            "id": 3,
            "type": "stat",
            "title": "Сбор очередей Redis успешен",
            "gridPos": { "h": 4, "w": 8, "x": 8, "y": 3 },
            "datasource": { "type": "prometheus", "uid": "ledgerpay-prometheus" },
            "targets": [{ "expr": "ledgerpay_queue_collector_success", "refId": "A" }]
        },
        {
            "id": 4,
            "type": "stat",
            "title": "Возраст снимка (сек)",
            "gridPos": { "h": 4, "w": 8, "x": 16, "y": 3 },
            "datasource": { "type": "prometheus", "uid": "ledgerpay-prometheus" },
            "targets": [{ "expr": "time() - ledgerpay_snapshot_timestamp_seconds", "refId": "A" }],
            "fieldConfig": { "defaults": { "unit": "s" } }
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "Операции по статусам",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
            "datasource": { "type": "prometheus", "uid": "ledgerpay-prometheus" },
            "targets": [
                { "expr": "ledgerpay_transactions_pending", "legendFormat": "pending", "refId": "A" },
                { "expr": "ledgerpay_transactions_processing", "legendFormat": "processing", "refId": "B" },
                { "expr": "ledgerpay_transactions_completed", "legendFormat": "completed", "refId": "C" },
                { "expr": "ledgerpay_transactions_failed", "legendFormat": "failed", "refId": "D" },
                { "expr": "ledgerpay_transactions_cancelled", "legendFormat": "cancelled", "refId": "E" }
            ]
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Outbox",
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
            "datasource": { "type": "prometheus", "uid": "ledgerpay-prometheus" },
            "targets": [
                { "expr": "ledgerpay_outbox_pending", "legendFormat": "pending", "refId": "A" },
                { "expr": "ledgerpay_outbox_processing", "legendFormat": "processing", "refId": "B" },
                { "expr": "ledgerpay_outbox_published", "legendFormat": "published", "refId": "C" },
                { "expr": "ledgerpay_outbox_failed", "legendFormat": "failed", "refId": "D" }
            ]
        },
        {
            "id": 7,
            "type": "stat",
            "title": "Outbox: возраст старейшего pending (сек)",
            "gridPos": { "h": 4, "w": 8, "x": 0, "y": 15 },
            "datasource": { "type": "prometheus", "uid": "ledgerpay-prometheus" },
            "targets": [{ "expr": "ledgerpay_outbox_oldest_pending_age_seconds", "refId": "A" }],
            "fieldConfig": { "defaults": { "unit": "s" } }
        },
        {
            "id": 8,
            "type": "timeseries",
            "title": "Очереди (ready LLEN)",
            "gridPos": { "h": 12, "w": 16, "x": 8, "y": 15 },
            "datasource": { "type": "prometheus", "uid": "ledgerpay-prometheus" },
            "targets": [
                { "expr": "ledgerpay_queue_transactions_total_backlog", "legendFormat": "transactions (sum shards)", "refId": "A" },
                { "expr": "ledgerpay_queue_outbox_backlog", "legendFormat": "outbox", "refId": "B" },
                { "expr": "ledgerpay_queue_default_backlog", "legendFormat": "default", "refId": "C" }
            ]
        },
        {
            "id": 9,
            "type": "stat",
            "title": "Секунд с последней сверки",
            "gridPos": { "h": 4, "w": 8, "x": 0, "y": 19 },
            "datasource": { "type": "prometheus", "uid": "ledgerpay-prometheus" },
            "targets": [{ "expr": "ledgerpay_reconciliation_last_check_age_seconds", "refId": "A" }]
        },
        {
            "id": 10,
            "type": "stat",
            "title": "Row gap (счета / операции)",
            "gridPos": { "h": 4, "w": 8, "x": 0, "y": 23 },
            "datasource": { "type": "prometheus", "uid": "ledgerpay-prometheus" },
            "targets": [
                { "expr": "ledgerpay_projection_account_row_gap", "legendFormat": "accounts", "refId": "A" },
                { "expr": "ledgerpay_projection_transaction_row_gap", "legendFormat": "transactions", "refId": "B" }
            ]
        }
    ]
}
